{
    "name": "autokamba/api",
    "description": "AutoKamba - API de assistência automóvel",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "pestphp/pest": "^2.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.0",
        "rector/rector": "^0.15",
        "friendsofphp/php-cs-fixer": "^3.0",
        "zircote/swagger-php": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "AutoKamba\\": "backend/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AutoKamba\\Tests\\": "backend/tests/"
        },
        "exclude-from-classmap": [
            "backend/tests/smoke.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --filter=Unit",
        "test:integration": "pest --filter=Integration",
        "stan": "phpstan analyse backend/src --level=5",
        "cs-fix": "php-cs-fixer fix backend/src",
        "generate-openapi": "php backend/scripts/generate-openapi.php",
        "generate-types": "cd frontend && node node_modules/.bin/openapi-typescript ../backend/storage/openapi.json -o src/types/api.ts"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}